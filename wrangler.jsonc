
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crypto-intelligence",
  "main": "./Server.js",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crypto-intelligence-db",
      "database_id": "a03f9008-0859-4134-8d9e-491af70c922b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVES",
      "bucket_name": "conan-data-archives-2026"
    }
  ]
}
